---
// Página estática "Quiénes somos" ("/quienes-somos/"). No depende de
// contenido de src/content: el texto está escrito directamente aquí
// porque es una página institucional fija, no una serie de entradas.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	titulo="Quiénes somos"
	descripcion="Conoce la misión, visión y trabajo de la Fundación FundeUpia."
>
	<h1>Quiénes somos</h1>

	<p>
		FundeUpia es una fundación dedicada a impulsar proyectos que mejoran la
		calidad de vida de nuestras comunidades a través de la educación, el
		acompañamiento social y el trabajo colaborativo.
	</p>

	<h2>Nuestra misión</h2>
	<p>
		Generar oportunidades reales de desarrollo para las personas y
		comunidades con las que trabajamos, mediante programas sostenibles y
		alianzas de largo plazo.
	</p>

	<h2>Nuestra visión</h2>
	<p>
		Ser una fundación de referencia, reconocida por el impacto medible de
		sus proyectos y por la transparencia en el uso de sus recursos.
	</p>

	<h2>Qué hacemos</h2>
	<ul>
		<li>Programas de educación y formación comunitaria.</li>
		<li>Acompañamiento a familias y grupos en situación de vulnerabilidad.</li>
		<li>Alianzas con otras organizaciones y voluntariado.</li>
	</ul>

	<p>
		¿Quieres saber más o colaborar con nosotros? Escríbenos a
		<a href="mailto:contacto@fundeupia.org">contacto@fundeupia.org</a>.
	</p>
</BaseLayout>
